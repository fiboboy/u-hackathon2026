  "rules_groups": [
    {
      "rules_group_id": "guest_waiting_rules",
      "metric_tracked": "wait_duration_seconds",
      "thresholds": [
        {
          "operator": ">=",
          "value": 300,
          "state_label": "tea_offered",
          "actions": [
            { "type": "show_bubble", "icon": "tea_cup" }
          ]
        },
        {
          "operator": ">=",
          "value": 600,
          "state_label": "irritation_breach",
          "actions": [
            { "type": "emit_particles", "emitter_id": "irritation_smoke" },
            { "type": "apply_shader", "shader_id": "warning_tint_pulse" },
            { "type": "notify", "channel": "admin_telegram" }
          ]
        }
      ]
    }
